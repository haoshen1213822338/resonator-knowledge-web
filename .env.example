PORT=3030
VAULT_DIR=D:\公司知识库
DEFAULT_SPACE_ID=共振体公司知识库
# 账号、登录会话和操作日志目录。正式部署时建议放在受保护且会备份的磁盘。
DATA_DIR=D:\公司知识库系统数据
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://你的兼容接口地址/v1
AI_MODEL=gemini-2.5-flash
AI_VISION_MODEL=gemini-2.5-flash
VISION_BATCH_SIZE=6

# 数据保障：自动备份默认关闭，正式部署后按磁盘容量决定是否开启。
BACKUP_DIR=D:\公司知识库备份
AUTO_BACKUP_ENABLED=false
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=7
TRASH_RETENTION_DAYS=30
IMPORT_MAX_ATTEMPTS=3

# 整理后的 90_AI输出 和向量索引使用 AES-256-GCM 加密。
# 未填写密钥时，服务器会在 DATA_DIR 自动生成 knowledge-encryption.key。
KNOWLEDGE_ENCRYPTION_ENABLED=true
# KNOWLEDGE_KEY_PATH=D:\公司知识库系统密钥\knowledge-encryption.key
# KNOWLEDGE_ENCRYPTION_KEY=32字节Base64或64位十六进制密钥

# 本地向量语义检索。模型首次使用时会下载到 VECTOR_CACHE_DIR。
VECTOR_ENABLED=true
VECTOR_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_CACHE_DIR=D:\公司知识库系统数据\models

# 复制本文件为 .env，然后填写兼容接口的 API Key。
# API Key 只能放在 .env，不能写进前端页面，也不能提交到 GitHub。
# AI_API_KEY=sk-...

# 可选：如果系统 Python 缺少 docx/pdf/excel/ppt 解析库，可指定另一个 Python。
# PARSER_PYTHON_CMD=C:\path\to\python.exe
